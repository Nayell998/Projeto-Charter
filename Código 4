import os
from datetime import datetime
import ttkbootstrap as ttk
from ttkbootstrap.constants import *

ARQUIVO = "biblioteca.txt"
LOG_ARQUIVO = "log.txt"
biblioteca = []


# --- FUNÇÃO DE LOG ---
def registrar_log(acao):
    with open(LOG_ARQUIVO, "a", encoding="utf-8") as log:
        data_hora = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
        log.write(f"[{data_hora}] {acao}\n")


# --- FUNÇÕES DE ARQUIVO ---
def carregar_dados():
    global biblioteca
    biblioteca.clear()
    if os.path.exists(ARQUIVO):
        with open(ARQUIVO, "r", encoding="utf-8") as f:
            for linha in f:
                partes = linha.strip().split(";")
                if len(partes) == 4:
                    titulo, autor, emprestado, quem = partes
                    biblioteca.append({
                        "titulo": titulo,
                        "autor": autor,
                        "emprestado": emprestado == "True",
                        "quem": None if quem == "None" else quem
                    })
        registrar_log("Dados carregados do arquivo.")
    else:
        registrar_log("Arquivo de dados não encontrado. Biblioteca iniciada vazia.")


def salvar_dados():
    with open(ARQUIVO, "w", encoding="utf-8") as f:
        for livro in biblioteca:
            linha = f"{livro['titulo']};{livro['autor']};{livro['emprestado']};{livro['quem']}\n"
            f.write(linha)
    registrar_log("Dados salvos no arquivo.")


# --- FUNÇÕES PRINCIPAIS ---
def atualizar_lista():
    lista.delete(*lista.get_children())
    for livro in biblioteca:
        status = f"Emprestado para {livro['quem']}" if livro["emprestado"] else "Disponível"
        lista.insert("", "end", values=(livro["titulo"], livro["autor"], status))


def cadastrar_livro():
    titulo = ttk.dialogs.Querybox.get_string("Título do livro:", "Cadastrar Livro")
    if not titulo:
        return
    autor = ttk.dialogs.Querybox.get_string("Autor do livro:", "Cadastrar Livro")
    if not autor:
        return

    biblioteca.append({
        "titulo": titulo,
        "autor": autor,
        "emprestado": False,
        "quem": None
    })
    salvar_dados()
    atualizar_lista()
    ttk.dialogs.Messagebox.ok(f"Livro '{titulo}' cadastrado com sucesso!", "Cadastro completo")
    registrar_log(f"Livro cadastrado: {titulo} ({autor}).")


def emprestar_livro():
    item = lista.selection()
    if not item:
        ttk.dialogs.Messagebox.warning("Selecione um livro primeiro.", "Atenção")
        return
    idx = lista.index(item)
    livro = biblioteca[idx]

    if livro["emprestado"]:
        ttk.dialogs.Messagebox.info("Este livro já está emprestado.", "Aviso")
        return

    nome = ttk.dialogs.Querybox.get_string("Nome de quem pega o livro:", "Emprestar Livro")
    if nome:
        livro["emprestado"] = True
        livro["quem"] = nome
        salvar_dados()
        atualizar_lista()
        ttk.dialogs.Messagebox.ok(f"Livro '{livro['titulo']}' emprestado para {nome}.", "Sucesso")
        registrar_log(f"Livro emprestado: '{livro['titulo']}' para {nome}.")


def devolver_livro():
    item = lista.selection()
    if not item:
        ttk.dialogs.Messagebox.warning("Selecione um livro primeiro.", "Atenção")
        return
    idx = lista.index(item)
    livro = biblioteca[idx]

    if not livro["emprestado"]:
        ttk.dialogs.Messagebox.info("Este livro não está emprestado.", "Informação")
        return

    livro["emprestado"] = False
    livro["quem"] = None
    salvar_dados()
    atualizar_lista()
    ttk.dialogs.Messagebox.ok(f"Livro '{livro['titulo']}' devolvido com sucesso!", "Devolução")
    registrar_log(f"Livro devolvido: '{livro['titulo']}'.")


def buscar_livro():
    termo = ttk.dialogs.Querybox.get_string("Digite o título ou autor:", "Buscar Livro")
    if not termo:
        return
    termo = termo.lower()
    encontrados = [livro for livro in biblioteca if termo in livro["titulo"].lower() or termo in livro["autor"].lower()]

    lista.delete(*lista.get_children())
    for livro in encontrados:
        status = f"Emprestado para {livro['quem']}" if livro["emprestado"] else "Disponível"
        lista.insert("", "end", values=(livro["titulo"], livro["autor"], status))

    registrar_log(f"Busca realizada: termo '{termo}' ({len(encontrados)} resultado(s)).")


def mostrar_todos():
    atualizar_lista()
    registrar_log("Listagem completa exibida.")


def abrir_log():
    if os.path.exists(LOG_ARQUIVO):
        with open(LOG_ARQUIVO, "r", encoding="utf-8") as f:
            conteudo = f.read()
        log_window = ttk.Toplevel(title="Registro de Log", size=(600, 400))
        text = ttk.ScrolledText(log_window, wrap="word")
        text.insert("1.0", conteudo)
        text.configure(state="disabled")
        text.pack(fill="both", expand=True, padx=10, pady=10)
    else:
        ttk.dialogs.Messagebox.info("Nenhum log encontrado.", "Log")


# --- INTERFACE GRÁFICA ---
janela = ttk.Window(themename="darkly")
janela.title("Biblioteca Solidária")
janela.geometry("750x500")

titulo_lbl = ttk.Label(janela, text="Biblioteca Solidária", font=("Segoe UI", 18, "bold"))
titulo_lbl.pack(pady=15)

# --- LISTA DE LIVROS ---
colunas = ("Título", "Autor", "Status")
lista = ttk.Treeview(janela, columns=colunas, show="headings", bootstyle=INFO)
for col in colunas:
    lista.heading(col, text=col)
    lista.column(col, width=220 if col != "Status" else 280)
lista.pack(padx=10, pady=10, fill="both", expand=True)

# --- BOTÕES ---
frame_botoes = ttk.Frame(janela)
frame_botoes.pack(pady=10)

botoes = [
    ("Cadastrar", cadastrar_livro, SUCCESS),
    ("Emprestar", emprestar_livro, PRIMARY),
    ("Devolver", devolver_livro, INFO),
    ("Buscar", buscar_livro, WARNING),
    ("Mostrar Todos", mostrar_todos, SECONDARY),
    ("Ver Log", abrir_log, DARK)
]

for i, (texto, cmd, estilo) in enumerate(botoes):
    ttk.Button(frame_botoes, text=texto, bootstyle=estilo, width=18, command=cmd).grid(row=i // 3, column=i % 3, padx=8, pady=6)

# --- EXECUÇÃO ---
carregar_dados()
atualizar_lista()
janela.mainloop()
